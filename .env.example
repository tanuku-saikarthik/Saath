# Copy to .env and fill in. Everything is optional: with no keys the app runs in mock mode.

# ---------- Bolna: the phone calls ----------
BOLNA_API_KEY=
BOLNA_AGENT_ID_TE=
BOLNA_AGENT_ID_HI=
BOLNA_FROM_NUMBER=
# English agent that phones you with alerts (prompts/agent_alert_en.md)
BOLNA_AGENT_ID_ALERT=
# true once the Telugu/Hindi agent has a Transfer Call tool to your number (prompts/bolna_tools.md)
TRANSFER_ON_EMERGENCY=false
# Same value as the api_token on the alert_family_urgent tool (also guards the caller-identification URL)
TOOL_TOKEN=
# The Bolna number she can call any time (SOS line, prompts/bolna_tools.md section 3). Shown in Profile.
SOS_NUMBER=
# Ring her straight back if she calls Saath and the line drops before she speaks
CALLBACK_ON_DROPPED=true

# ---------- LLM for post-call scoring (pick ONE block) ----------
# A) OpenAI
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.4-mini
LLM_API_KEY=
LLM_JSON_MODE=true

# B) gpt-oss on Groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=
# LLM_JSON_MODE=true

# C) gpt-oss locally with Ollama (`ollama pull gpt-oss:20b`, no key)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=gpt-oss:20b
# LLM_JSON_MODE=true

# D) Sarvam-105B (buildathon sponsor). Leave LLM_API_KEY empty to use SARVAM_API_KEY.
# LLM_BASE_URL=https://api.sarvam.ai/v1
# LLM_MODEL=sarvam-105b
# LLM_JSON_MODE=false
SARVAM_API_KEY=

# ---------- Browser test call (OpenAI listens, replies, speaks) ----------
# Uses LLM_API_KEY when LLM_BASE_URL is OpenAI; otherwise set OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts-2025-12-15
OPENAI_TTS_VOICE=coral

# ---------- Alerts outside the app ----------
# Every alert, daily summary and Sunday digest is POSTed here as JSON.
# Connect it to WhatsApp, email or Slack with Make, Zapier or n8n.
ALERT_WEBHOOK_URL=

# ---------- Voice emotion model ----------
# hf = Hugging Face (default), ms = ModelScope
VOICE_HUB=hf
VOICE_MODEL=
# Which recording channel is the parent on a Bolna call (check on the first real call)
PARENT_CHANNEL=1

# ---------- App ----------
PUBLIC_BASE_URL=
TEST_PHONE_NUMBER=
TIMEZONE=Asia/Kolkata
RETRY_MINUTES=30
ENABLE_SCHEDULER=true
WEBHOOK_IP_ALLOWLIST=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Hosted demo: load the labelled sample data when the database is empty
AUTO_SEED=false

# Family app password. Leave empty on localhost; set it on any public server
APP_PASSWORD=
